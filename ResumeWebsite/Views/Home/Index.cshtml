@model ResumeWebsite.Models.ResumeViewModel

@{
    ViewData["Title"] = "Portfolio";
}

<!-- HOME -->
<section class="hero-section">

    <div class="hero-card">

        <div class="hero-content">

            <span class="hello-text">
                HI THERE!
            </span>

            <h1>
                I'M <span class="highlight">@Model.Name</span>
            </h1>

            <h4 class="mb-4">
                @Model.Title
            </h4>

            <p>
                @Model.Summary
            </p>

            <a href="#contact" class="btn btn-warning btn-lg mt-3">
                CONTACT ME
            </a>

        </div>

        <div class="hero-image">

            <img src="~/images/profile.jpeg"
                 alt="Profile"
                 class="profile-image" />

        </div>

    </div>

</section>

<!-- ABOUT -->
<section id="about" class="section-card">

    <h2 class="big-title">
        ABOUT ME
    </h2>

    <div class="row">

        <div class="col-md-8">

            <h4>
                I'm @Model.Name
            </h4>

            <p>
                Passionate Software Developer with experience in
                ASP.NET, .NET Core, SQL Server, APIs,
                Android and iOS application development.
            </p>

        </div>

        <div class="col-md-4">

            <div class="stats-grid">

                <div class="stat-box">
                    <h3>4+</h3>
                    <span>Years Experience</span>
                </div>

                <div class="stat-box">
                    <h3>10+</h3>
                    <span>Projects</span>
                </div>

                <div class="stat-box">
                    <h3>5+</h3>
                    <span>Technologies</span>
                </div>

                <div class="stat-box">
                    <h3>100%</h3>
                    <span>Commitment</span>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- RESUME -->
<section id="resume" class="section-card">

    <h2 class="big-title">
        RESUME
    </h2>

    <div class="row">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body">

                    <h4>Education</h4>

                    <ul>
                        <li>10th - @Model.Education10th</li>
                        <li>12th - @Model.Education12th</li>
                    </ul>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-body">

                    <h4>Experience</h4>

                    <p>@Model.Experience</p>

                    <p>
                        Developed enterprise web applications,
                        APIs and mobile applications using Microsoft technologies.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- SKILLS -->
<section id="skills" class="section-card">

    <h2 class="big-title">
        SKILLS
    </h2>

    <div class="row">

        <div class="col-md-6 mb-4">

            <div class="card skill-card">

                <div class="card-body">

                    <h4>Frameworks</h4>

                    @foreach (var item in Model.Frameworks)
                    {
                        <span class="skill-badge">@item</span>
                    }

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card skill-card">

                <div class="card-body">

                    <h4>Languages</h4>

                    @foreach (var item in Model.Languages)
                    {
                        <span class="skill-badge">@item</span>
                    }

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4>Database</h4>

                    @foreach (var item in Model.Databases)
                    {
                        <span class="skill-badge">@item</span>
                    }

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4>Platforms</h4>

                    @foreach (var item in Model.Platforms)
                    {
                        <span class="skill-badge">@item</span>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

<!-- PORTFOLIO -->
<section id="portfolio" class="section-card">

    <h2 class="big-title">
        PORTFOLIO
    </h2>

    <div class="row">

        @foreach (var project in Model.Projects)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow h-100">

                    <div class="card-body">

                        <h4>@project.Name</h4>

                        <p>@project.Description</p>

                        <a href="@project.GithubUrl"
                           target="_blank"
                           class="btn btn-warning">
                            View Project
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>

<!-- CONTACT -->
<section id="contact" class="section-card">

    <h2 class="big-title">
        CONTACT
    </h2>

    <div class="contact-box">

        <h4>📞 @Model.Phone</h4>

        <h4 class="mt-3">✉️ @Model.Email</h4>

    </div>

</section>