@model ResumeWebsite.Models.ResumeViewModel

@{
    ViewData["Title"] = "Portfolio";
}
<!-- ================= HERO SECTION ================= -->

<section class="hero-section">

    <div class="hero-card">

        <div class="hero-content">

            <span class="hello-text">
                HELLO, I'M
            </span>

            <h1>
                <span class="highlight">@Model.Name</span>
            </h1>

            <h3 class="mb-4">
                @Model.Title
            </h3>

            <p class="hero-description">
                @Model.Summary
            </p>

            <a href="#contact" class="btn btn-warning btn-lg mt-4 px-5">
                Contact Me
            </a>

        </div>

        <div class="hero-image">

            <img src="~/images/profile.png"
                 alt="Profile"
                 class="profile-image" />

        </div>

    </div>

</section>

<!-- ================= ABOUT ================= -->

<section id="about" class="section-card">

    <h2 class="big-title">
        About Me
    </h2>

    <div class="row align-items-center">

        <div class="col-lg-8">

            <h3 class="mb-4">
                Software Developer
            </h3>

            <p>
                Passionate Software Developer with experience in ASP.NET,
                .NET Core, SQL Server, REST APIs, Android and iOS application
                development. Strong knowledge of C#, Entity Framework,
                HTML, CSS, JavaScript and Bootstrap.

                I enjoy building scalable applications, solving complex
                problems and creating user-friendly digital solutions while
                continuously learning modern technologies.
            </p>

        </div>

        <div class="col-lg-4">

            <div class="stats-grid">

                <div class="stat-box">
                    <h3>4+</h3>
                    <span>Years Experience</span>
                </div>

                <div class="stat-box">
                    <h3>5+</h3>
                    <span>Projects</span>
                </div>

                <div class="stat-box">
                    <h3>5+</h3>
                    <span>Technologies</span>
                </div>

                <div class="stat-box">
                    <h3>100%</h3>
                    <span>Dedication</span>
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= RESUME ================= -->

<section id="resume" class="section-card">

    <h2 class="big-title">
        Resume
    </h2>

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card custom-card h-100">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        🎓 Education
                    </h3>

                    <h5>
                        Bachelor of Technology
                    </h5>

                    <h6 class="text-warning">
                        Information Technology
                    </h6>

                    <p>
                        Anna University,
                        Tiruchirappalli,
                        Tamil Nadu
                    </p>

                    <p>
                        Successfully completed Bachelor of Technology
                        in Information Technology.
                    </p>

                    <span class="badge bg-warning text-dark p-2">
                        CGPA : 7.2 / 10
                    </span>

                    <hr />

                    <ul>

                        <li>
                            10th - @Model.Education10th
                        </li>

                        <li>
                            12th - @Model.Education12th
                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card custom-card h-100">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        💼 Experience
                    </h3>

                    <p>
                        @Model.Experience
                    </p>

                    <p>

                        • ASP.NET MVC Development

                    </p>

                    <p>

                        • .NET Core Web API

                    </p>

                    <p>

                        • SQL Server Database Design

                    </p>

                    <p>

                        • Android & iOS Application Development

                    </p>

                    <p>

                        • Bug Fixing & Performance Optimization

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= SKILLS ================= -->

<section id="skills" class="section-card">

    <h2 class="big-title">
        Skills
    </h2>

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4 class="mb-3">
                        Frameworks
                    </h4>

                    @foreach (var item in Model.Frameworks)
                    {
                        <span class="skill-badge">
                            @item
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4 class="mb-3">
                        Languages
                    </h4>

                    @foreach (var item in Model.Languages)
                    {
                        <span class="skill-badge">
                            @item
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4 class="mb-3">
                        Databases
                    </h4>

                    @foreach (var item in Model.Databases)
                    {
                        <span class="skill-badge">
                            @item
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card skill-card">

                <div class="card-body">

                    <h4 class="mb-3">
                        Platforms
                    </h4>

                    @foreach (var item in Model.Platforms)
                    {
                        <span class="skill-badge">
                            @item
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ================= CONTACT ================= -->

<section id="contact" class="section-card">

    <h2 class="big-title">
        Contact Me
    </h2>

    <div class="contact-box">

        <h4>
            📞 @Model.Phone
        </h4>

        <h4 class="mt-4">
            ✉️ @Model.Email
        </h4>

        <div class="mt-4">

            <a href="#" class="btn btn-dark me-2">
                LinkedIn
            </a>

            <a href="#" class="btn btn-dark">
                GitHub
            </a>

        </div>

    </div>

</section>

<footer class="text-center text-light mb-5">

    <small>

        © @DateTime.Now.Year @Model.Name.
        All Rights Reserved.

    </small>

</footer>
